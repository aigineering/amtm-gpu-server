---
# Rendered by the `vllm` Ansible role — do not edit by hand, changes will be
# overwritten on the next playbook run. Edit vllm_instances in group_vars instead.
services:
{% for instance in vllm_instances %}
  vllm-{{ instance.name }}:
    image: "{{ vllm_image }}"
    container_name: "vllm-{{ instance.name }}"
    restart: unless-stopped
    ipc: host
    ports:
      - "{{ instance.port }}:{{ instance.port }}"
    environment:
      # Model repo is already on disk — never fall back to a Hugging Face Hub call.
      HF_HUB_OFFLINE: "1"
      TRANSFORMERS_OFFLINE: "1"
    volumes:
      - "{{ instance.model_path }}:/models/{{ instance.name }}:ro"
    # vLLM profiles free GPU memory at startup to size its KV cache. Two engines
    # profiling concurrently each see the other's in-flight allocations and
    # compute garbage (negative KV memory) — so instances start strictly one at
    # a time: each waits for the previous one's /health before starting.
    healthcheck:
      test: ["CMD-SHELL", "curl -sf http://localhost:{{ instance.port }}/health || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: {{ vllm_healthcheck_start_period | default('600s') }}
{% if not loop.first %}
    depends_on:
      vllm-{{ vllm_instances[loop.index0 - 1].name }}:
        condition: service_healthy
{% endif %}
    command:
      - "--model"
      - "/models/{{ instance.name }}"
      - "--served-model-name"
      - "{{ instance.served_model_name | default(instance.name) }}"
      - "--port"
      - "{{ instance.port | string }}"
      - "--gpu-memory-utilization"
      - "{{ instance.gpu_memory_utilization }}"
      - "--max-model-len"
      - "{{ instance.max_model_len | string }}"
{% for arg in instance.extra_args | default([]) %}
      {# to_json, not bare quoting: args may themselves contain double quotes,
         e.g. the JSON value of --limit-mm-per-prompt #}
      - {{ arg | to_json }}
{% endfor %}
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              count: all
              capabilities: ["gpu"]
{% endfor %}
